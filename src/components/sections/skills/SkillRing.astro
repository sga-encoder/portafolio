---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  percentage: number;
  side: "left" | "right";
  image: ImageMetadata;
  alt: string;
}

const { percentage, side, image, alt } = Astro.props;

const radius = 42;
const circumference = 2 * Math.PI * radius;
const clamped = Math.min(Math.max(percentage, 0), 100);
const offset = circumference * (1 - clamped / 100);
const ringColor =
  side === "left" ? "var(--sphere-left-color, var(--color-brand))" : "var(--sphere-right-color, var(--color-accent-2))";
---

<div class="skill-ring" style={`--ring-color: ${ringColor};`}>
  <svg viewBox="0 0 100 100" class="skill-ring__svg" aria-hidden="true">
    <circle
      cx="50"
      cy="50"
      r={radius}
      class="skill-ring__progress"
      stroke-dasharray={circumference}
      stroke-dashoffset={offset}
    />
  </svg>
  <Image src={image} alt={alt} class="skill-ring__icon" width={48} height={48} />
</div>

<style>
  .skill-ring {
    position: relative;
    /*
     * Fluido en función del ancho, pero con techo de alto vía `min(..., 9vh)`: en
     * laptops anchas pero de alto limitado (~1366x768), la fórmula solo-de-ancho
     * (`1.88rem + 5.46vw`, pensada para llegar a 7rem a 1500px de ancho) daba
     * anillos de ~104px que, con 5 tarjetas apiladas por columna (`SkillColumn`),
     * desbordaban el `md:h-screen` — el `justify-content:center` reparte ese
     * desborde mitad arriba (tapa el `<h2>`) y mitad abajo (tapa la sección
     * siguiente). El término `9vh` acota el anillo cuando el alto es el factor
     * limitante, sin tocar el crecimiento por ancho en monitores altos.
     */
    width: clamp(2.5rem, min(calc(1.88rem + 5.46vw), 9vh), 7rem);
    aspect-ratio: 1 / 1;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Celular en landscape (~320-430px de alto): con 5 tarjetas apiladas por
     columna, el anillo de 4.5rem (piso fijo de la fórmula de arriba, pensada
     solo en función del ancho) no deja que la columna quepa en el alto
     disponible. Aquí sí depende del alto, con piso más bajo. */
  @media (max-height: 499px) {
    .skill-ring {
      width: clamp(2.25rem, 11vh, 4.5rem);
    }
  }

  .skill-ring__svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    /* Arranca el trazo de progreso en las 12 y avanza en sentido horario. */
    transform: rotate(-90deg);
    /* Los <svg> recortan su contenido en su propio borde por defecto; sin esto
       el drop-shadow (que se extiende más allá del trazo) queda cortado. */
    overflow: visible;
  }

  .skill-ring__progress {
    fill: none;
    stroke: var(--ring-color);
    stroke-width: 6;
    stroke-linecap: round;
    transition: stroke 0.4s ease;
    filter: drop-shadow(0 2px 5px rgba(0, 0, 0, 0.5)) drop-shadow(0 0 14px rgba(0, 0, 0, 0.4));
  }

  .skill-ring__icon {
    position: relative;
    width: 46%;
    height: 46%;
    object-fit: contain;
  }
</style>
