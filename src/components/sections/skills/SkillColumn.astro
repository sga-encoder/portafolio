---
import SkillCard from "./SkillCard.astro";
import type { Skill } from "../../../data/skills";

interface Props {
  skills: Skill[];
  side: "left" | "right";
}

const { skills, side } = Astro.props;

/**
 * Desplazamiento en chevron: simétrico respecto al ítem central (índice 2),
 * que es el que más se aleja hacia el borde de la columna. El signo lo pone
 * `side` (izquierda hacia el borde izquierdo, derecha hacia el borde derecho).
 */
const CHEVRON_STEPS = [1, 4, 8, 4, 1];
const sign = side === "left" ? -1 : 1;
---

<div class={`skill-column skill-column--${side}`}>
  {
    skills.map((skill, index) => (
      <div class="skill-column__item" style={`--chevron-offset: ${sign * CHEVRON_STEPS[index]};`}>
        <SkillCard skill={skill} />
      </div>
    ))
  }
</div>

<style>
  .skill-column {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(1rem, 1.8vh, 1.25rem);
    height: 100%;
    justify-content:center;
  }

  .skill-column__item {
    transform: translateX(calc(var(--chevron-offset) * clamp(0.6rem, 2.4vw, 1.75rem)));
  }
</style>
