---
import SkillGroup from "./SkillGroup.astro";
import type { Skill, SkillCategory } from "../../../data/skillsPages";

interface Props {
  skills: Skill[];
  side: "left" | "right";
  /** `desktop` (default): chevron simétrico. `mobile` (068): apilado, sin chevron. */
  variant?: "desktop" | "mobile";
}

const { skills, side, variant = "desktop" } = Astro.props;

/**
 * Desplazamiento en chevron generalizado a cualquier cantidad de skills (069: antes fijo a 5
 * posiciones `[1, 4, 8, 4, 1]`, `017`/`020`). Simétrico respecto al centro del array — el ítem
 * central es el que más se aleja hacia el borde de la columna, tapereando a un mínimo en los
 * extremos. Con 5 ítems reproduce exactamente `[1, 4, 8, 4, 1]` (ver `plan.md`: la página migrada
 * de `068` debe verse idéntica a antes); con otras cantidades generaliza la misma curva.
 */
const MIN_OFFSET = 1;
const MAX_OFFSET = 8;
const CHEVRON_EXPONENT = 1.22;

function chevronOffsets(count: number): number[] {
  if (count <= 1) return count === 1 ? [0] : [];
  const center = (count - 1) / 2;
  return Array.from({ length: count }, (_, index) => {
    const distance = Math.abs(index - center);
    const t = distance / center;
    return Math.round(MIN_OFFSET + (MAX_OFFSET - MIN_OFFSET) * (1 - t) ** CHEVRON_EXPONENT);
  });
}

const sign = side === "left" ? -1 : 1;
// Mobile apila sin chevron (decoración desktop, ver `plan.md`) — offsets en 0.
const steps = variant === "desktop" ? chevronOffsets(skills.length) : skills.map(() => 0);

/**
 * El offset más chico siempre cae en los extremos del array; cada subgrupo de categoría siempre
 * contiene uno de esos extremos. Alineando el título al mismo extremo (start para el primer
 * subgrupo, end para el segundo) el título queda junto al ítem con menor desplazamiento, evitando
 * que el chevron del ítem central (el de mayor offset) lo tape.
 */

interface Group {
  category: SkillCategory;
  items: { skill: Skill; offset: number }[];
}

const groups: Group[] = [];
skills.forEach((skill, index) => {
  const offset = sign * steps[index];
  const current = groups[groups.length - 1];
  if (current && current.category === skill.category) {
    current.items.push({ skill, offset });
  } else {
    groups.push({ category: skill.category, items: [{ skill, offset }] });
  }
});
---

<div class={`skill-column skill-column--${side} skill-column--${variant}`}>
  {
    groups.map((group, groupIndex) => (
      <SkillGroup
        category={group.category}
        items={group.items}
        side={side}
        variant={variant}
        align={groupIndex === 0 ? "start" : "end"}
      />
    ))
  }
</div>

<style>
  .skill-column {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100%;
    gap: clamp(1.5rem, 3vh, 2.5rem);
  }

  /* Celular en landscape (~320-430px de alto): el gap fijo de 1.5rem entre
     categorías no deja espacio suficiente para que los ítems + textos
     quepan sin desbordar la sección — ver `SkillRing`/`SkillCard`. */
  @media (max-height: 499px) {
    .skill-column {
      gap: clamp(0.4rem, 2vh, 1.5rem);
    }
  }

  /* Mobile (068): columna apilada dentro de un contenedor de alto automático, no de `md:h-screen`. */
  .skill-column--mobile {
    height: auto;
    width: 100%;
  }
</style>
