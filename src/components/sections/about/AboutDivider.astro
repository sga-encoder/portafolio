---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={["about-divider", className]} role="presentation"></div>

<style>
  .about-divider {
    height: clamp(6px, 0.8vh, 10px);
    border-radius: 999px;
    background: linear-gradient(90deg, var(--sphere-c-color, #00c080), var(--sphere-a-color, var(--color-brand)));
  }
</style>
