---
import type { SocialLink } from "../../../data/profile";

interface Props {
  link: SocialLink;
  /** Sin label visible ni escalado `short:` — para usos fuera de una sección `h-screen` (ej. el footer). */
  compact?: boolean;
  /** Color del ícono/borde en modo `compact` (ej. reactivo al fondo 3D). Ignorado si `compact` es falso. */
  color?: string;
}

const { link, compact = false, color } = Astro.props;
const isExternal = link.platform !== "email";
const circleStyle = compact
  ? `border-color: ${color}; color: ${color}; background-color: color-mix(in srgb, var(--color-surface) 80%, transparent);`
  : undefined;
---

<a
  href={link.href}
  aria-label={compact ? link.label : undefined}
  title={compact ? link.label : undefined}
  class={
    compact
      ? "flex shrink-0 items-center transition-transform duration-200 hover:scale-110"
      : "flex min-w-0 items-center gap-3 short:gap-1.5 text-ink transition-colors hover:text-brand"
  }
  target={isExternal ? "_blank" : undefined}
  rel={isExternal ? "noreferrer" : undefined}
>
  <span
    class={
      compact
        ? "flex h-9 w-9 shrink-0 items-center justify-center rounded-full border-2"
        : "flex h-9 w-9 short:h-6 short:w-6 shrink-0 items-center justify-center rounded-lg border-2 border-current"
    }
    style={circleStyle}
    aria-hidden="true"
  >
    {
      link.platform === "instagram" && (
        <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8">
          <rect x="3" y="3" width="18" height="18" rx="5" />
          <circle cx="12" cy="12" r="4.2" />
          <circle cx="17.2" cy="6.8" r="1.1" fill="currentColor" stroke="none" />
        </svg>
      )
    }
    {
      link.platform === "linkedin" && (
        <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8">
          <rect x="3" y="3" width="18" height="18" rx="3" />
          <circle cx="8" cy="9" r="0.9" fill="currentColor" stroke="none" />
          <line x1="8" y1="12" x2="8" y2="17" />
          <line x1="12.5" y1="17" x2="12.5" y2="12.5" />
          <path d="M12.5 14.2c0 -1.5 3.5 -1.5 3.5 0v2.8" />
        </svg>
      )
    }
    {
      link.platform === "email" && (
        <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8">
          <rect x="3" y="5" width="18" height="14" rx="2.5" />
          <path d="M4 7l8 6 8-6" />
        </svg>
      )
    }
  </span>
  {!compact && <span class="min-w-0 break-words font-body text-sm sm:text-base">{link.label}</span>}
</a>
