---
import { profile } from "../../data/profile";
import { getCloudinaryUrl } from "../../utils/cloudinaryManifest";
import AboutFrame from "./about/AboutFrame.astro";
import AboutInfoBlock from "./about/AboutInfoBlock.astro";

const { about } = profile;
const personaUrl = getCloudinaryUrl("about/persona03", "q_auto,f_auto");
---

<section id="sobre-mi" class="flex min-h-screen w-full flex-col pb-20 md:h-screen md:flex-row md:pb-0 short:py-2">
  <div
    class="flex shrink-0 items-center justify-center py-6 short:py-1 md:h-full md:w-[12vw] md:items-end md:justify-center md:pb-[6vh]"
  >
    <h2 class="about-title font-display font-bold text-ink">Sobre mí</h2>
  </div>

  <div class="flex min-w-0 flex-1 flex-col justify-center gap-[3vh] px-[6vw] py-[3vh] short:gap-[1vh] short:py-[1vh] md:px-[4vw]">
    <AboutFrame class="flex-[2]">
      <p class="font-body text-ink-muted text-sm short:text-xs short:line-clamp-3">{about.bio}</p>
    </AboutFrame>

    <AboutInfoBlock about={about} class="hidden md:flex md:flex-col md:gap-[3vh] short:gap-[1vh]" />

    <div class="flex flex-row items-center gap-4 md:hidden">
      <AboutInfoBlock about={about} class="flex min-w-0 flex-1 flex-col gap-[3vh]" dividerClass="w-full" />
      <div class="w-[30vw] shrink-0">
        <img
          src={personaUrl}
          alt="Retrato de cuerpo completo del autor"
          class="h-auto w-full object-contain"
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>
  </div>

  <div class="hidden shrink-0 md:block md:h-full md:w-[40vw]">
    <img
      src={personaUrl}
      alt="Retrato de cuerpo completo del autor"
      class="h-full w-full object-contain object-center"
      loading="lazy"
      decoding="async"
    />
  </div>
</section>

<style>
  .about-title {
    font-size: clamp(1.75rem, 4vw, 3.5rem);
    white-space: nowrap;
  }

  @media (min-width: 768px) {
    .about-title {
      /* `vertical-rl` + rotate(180deg) = texto vertical que se lee de abajo hacia
         arriba (equivalente a rotar -90° un título horizontal), en flujo normal. */
      writing-mode: vertical-rl;
      transform: rotate(180deg);
    }
  }
</style>
