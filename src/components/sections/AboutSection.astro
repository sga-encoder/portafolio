---
import { Image } from "astro:assets";
import { profile } from "../../data/profile";
import persona from "../../assets/about/persona03.png";
import AboutFrame from "./about/AboutFrame.astro";
import AboutDivider from "./about/AboutDivider.astro";
import SocialLink from "./about/SocialLink.astro";

const { about } = profile;
---

<section id="sobre-mi" class="flex min-h-screen w-full flex-col md:h-screen md:flex-row">
  <div
    class="flex shrink-0 items-center justify-center py-6 md:h-full md:w-[12vw] md:items-end md:justify-center md:pb-[6vh]"
  >
    <h2 class="about-title font-display font-bold text-ink">Sobre mí</h2>
  </div>

  <div class="flex min-w-0 flex-1 flex-col justify-center gap-[3vh] px-[6vw] py-[3vh] md:px-[4vw]">
    <AboutFrame class="flex-[2]">
      <p class="font-body text-ink-muted">{about.bio}</p>
    </AboutFrame>

    <div>
      <h3 class="font-display font-bold text-ink" style="font-size: clamp(1rem, 1.4vw, 1.375rem);">Estudios:</h3>
      <p class="mt-1 font-body text-ink-muted" style="font-size: clamp(0.9rem, 1.2vw, 1.125rem);">
        {about.study.institution} <span class="font-display font-bold text-brand">({about.study.period})</span>
      </p>
    </div>

    <AboutDivider class="w-1/2" />

    <div>
      <h3 class="font-display font-bold text-ink" style="font-size: clamp(1rem, 1.4vw, 1.375rem);">Contacto:</h3>
      <div class="mt-3 flex flex-col gap-3">
        {about.social.map((link) => <SocialLink link={link} />)}
      </div>
    </div>
  </div>

  <div class="hidden shrink-0 md:block md:h-full md:w-[40vw]">
    <Image
      src={persona}
      alt="Retrato de cuerpo completo del autor"
      class="h-full w-full object-contain object-center"
      sizes="40vw"
    />
  </div>
</section>

<style>
  .about-title {
    font-size: clamp(1.75rem, 4vw, 3.5rem);
    white-space: nowrap;
  }

  @media (min-width: 768px) {
    .about-title {
      /* `vertical-rl` + rotate(180deg) = texto vertical que se lee de abajo hacia
         arriba (equivalente a rotar -90° un título horizontal), en flujo normal. */
      writing-mode: vertical-rl;
      transform: rotate(180deg);
    }
  }
</style>
