---
import { getImage } from "astro:assets";
import { PROJECTS } from "../../data/projects";
import ProjectCarousel from "../projects/ProjectCarousel";

const projects = await Promise.all(
  PROJECTS.map(async (project) => ({
    id: project.id,
    title: project.title,
    description: project.description,
    link: project.link,
    imageSrc: project.image ? (await getImage({ src: project.image, width: 1200 })).src : undefined,
  })),
);
---

<section id="proyectos" class="flex h-screen w-full flex-col justify-center gap-10 px-4 py-16">
  <ProjectCarousel client:load projects={projects} />
  <h2 class="text-center font-display text-8xl font-bold text-ink sm:text-8xl">Proyectos</h2>
</section>
