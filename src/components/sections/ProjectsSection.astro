---
import { getCollection } from "astro:content";
import { getCloudinaryUrl } from "../../utils/cloudinaryManifest";
import { CAROUSEL_PROJECT_IDS } from "../../data/carousel";
import ProjectCarousel from "../projects/ProjectCarousel";

// Título/descripción/imagen salen del content collection (071) — misma fuente que
// `/proyectos/[slug]` — nunca de `projects.json`, para que no puedan desincronizarse de la
// portada real. `carousel.ts` solo aporta membresía + orden.
const entries = await getCollection("projects");
const projects = CAROUSEL_PROJECT_IDS.map((id) => {
  const entry = entries.find((candidate) => candidate.id === id);
  if (!entry) return null;
  return {
    id,
    title: entry.data.title,
    description: entry.data.summary,
    link: `/proyectos/${id}`,
    imageSrc: getCloudinaryUrl(entry.data.coverImage, "w_1200,q_auto,f_auto"),
  };
}).filter((project): project is NonNullable<typeof project> => project !== null);
---

<section
  id="proyectos"
  class="flex min-h-screen w-full flex-col justify-center gap-10 px-4 py-16 md:h-screen short:gap-8 short:py-4"
>
  <ProjectCarousel client:load projects={projects} />
  <h2
    class="text-center font-display text-[clamp(1.75rem,9vw,3rem)] font-bold text-ink md:text-8xl short:text-[clamp(1.25rem,6vh,3rem)]"
  >
    Proyectos
  </h2>
  <a
    href="/proyectos"
    class="mx-auto inline-block rounded-full px-6 py-2.5 text-center font-body text-sm font-semibold text-(--color-brand-contrast) transition-transform hover:scale-105"
    style="background: linear-gradient(135deg, var(--sphere-left-color, var(--color-brand)), var(--sphere-right-color, var(--color-accent-2)));"
  >
    Ver todos los proyectos →
  </a>
</section>
