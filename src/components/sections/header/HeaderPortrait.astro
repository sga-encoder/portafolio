---
import { getCloudinaryUrl } from "../../../utils/cloudinaryManifest";
import type { HeaderPortraitFrame } from "../../../data/profile";

interface Props {
  frames: HeaderPortraitFrame[];
  intervalSeconds: number;
  alt: string;
  hideWord?: boolean;
  variant?: "side" | "background";
  class?: string;
}

const {
  frames,
  intervalSeconds,
  alt,
  hideWord = false,
  variant = "side",
  class: className,
} = Astro.props;
---

<div
  class:list={["header-portrait", className]}
  data-variant={variant}
  data-interval={intervalSeconds}
>
  {frames.map((frame, index) => (
    <div class="header-portrait__frame" data-active={index === 0 ? "true" : "false"}>
      {!hideWord && (
        <span class="header-portrait__word" aria-hidden="true">{frame.word}</span>
      )}
      <img
        src={getCloudinaryUrl(frame.imageKey, "q_auto,f_auto")}
        alt={index === 0 ? alt : ""}
        class="header-portrait__image"
        loading="eager"
        decoding="async"
      />
    </div>
  ))}
</div>

{frames.length > 1 && (
  <script>
    function initHeaderPortraitRotation() {
      document.querySelectorAll<HTMLElement>(".header-portrait[data-interval]").forEach((root) => {
        if (root.dataset.rotationInit === "true") return;
        root.dataset.rotationInit = "true";
        const frames = Array.from(root.querySelectorAll<HTMLElement>(".header-portrait__frame"));
        if (frames.length <= 1) return;
        let active = frames.findIndex((f) => f.dataset.active === "true");
        if (active < 0) active = 0;
        const intervalMs = Number(root.dataset.interval) * 1000 || 6000;
        const timer = setInterval(() => {
          frames[active].dataset.active = "false";
          active = (active + 1) % frames.length;
          frames[active].dataset.active = "true";
        }, intervalMs);
        // Limpieza al salir de la página vía View Transitions, mismo criterio que otros
        // listeners globales del sitio (evita timers huérfanos tras astro:page-load repetidos).
        document.addEventListener("astro:before-swap", () => clearInterval(timer), { once: true });
      });
    }
    initHeaderPortraitRotation();
    document.addEventListener("astro:page-load", initHeaderPortraitRotation);
  </script>
)}

<style>
  .header-portrait {
    position: relative;
    height: 100%;
    width: 100%;
  }

  .header-portrait__frame {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 600ms ease;
  }

  .header-portrait__frame[data-active="true"] {
    opacity: 1;
  }

  .header-portrait__frame .header-portrait__image {
    position: absolute;
    inset: calc(var(--frame-border, 20px) * -1) calc(var(--frame-border, 20px) * -1)
      calc(var(--frame-border, 20px) * -1) auto;
    right: calc(var(--frame-border, 20px) * -1);
    height: calc(100% + var(--frame-border, 20px) * 2);
    width: auto;
    max-width: none;
    object-fit: contain;
    object-position: bottom right;
    transform: scale(1.1);
    transform-origin: bottom right;
  }

  /* Variante "background": el retrato deja de ser una columna lateral y pasa
     a cubrir todo el marco por detrás del contenido (usada en el layout
     mobile portrait de HeaderSection). */
  .header-portrait[data-variant="background"] .header-portrait__frame .header-portrait__image {
    inset: 0;
    right: auto;
    height: 100%;
    width: 100%;
    object-fit: contain;
    object-position: top center;
    transform: none;
  }

  .header-portrait__word {
    position: absolute;
    z-index: 1;
    left: 22%;
    bottom: 55%;
    transform-origin: left bottom;
    transform: rotate(-90deg) translateX(-100%);
    display: inline-block;
    white-space: nowrap;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2.5rem, 5.5vw, 5.5rem);
    letter-spacing: 0.05em;
    color: color-mix(in srgb, var(--color-ink) 100%, transparent 65%);
  }

  @media (prefers-reduced-motion: reduce) {
    .header-portrait__frame {
      transition: none;
    }
  }
</style>
