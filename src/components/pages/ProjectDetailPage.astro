---
// Cuerpo de `/proyectos/[slug]`, compartido por ambos idiomas (100); `getStaticPaths` vive en
// `projectDetailPaths.ts` y cada página de `src/pages/` solo lo reexporta.
import { getCollection, getEntry, render, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectHeader from "../../components/projects/detail/ProjectHeader.astro";
import ProjectDetailNav from "../../components/projects/detail/ProjectDetailNav.astro";
import SiteMainNav from "../../components/nav/SiteMainNav";
import ProjectPageBackground from "../../components/projects/detail/ProjectPageBackground.astro";
import ProjectViewTracker from "../../components/projects/detail/ProjectViewTracker.astro";
import ProjectSwipeNav from "../../components/projects/detail/ProjectSwipeNav.astro";
import ProjectScene3D from "../../components/projects/detail/scene/ProjectScene3D";
import ProjectDescriptionContext from "../../components/projects/detail/ProjectDescriptionContext.astro";
import ProjectDivider from "../../components/projects/detail/ProjectDivider.astro";
import ProjectLiveSteps from "../../components/projects/detail/ProjectLiveSteps.astro";
import ProjectGallery from "../../components/projects/detail/ProjectGallery.tsx";
import ProjectMainContent from "../../components/projects/detail/ProjectMainContent.astro";
import { getCloudinaryUrl, getCloudinaryColors } from "../../utils/cloudinaryManifest";
import { formatProjectDate } from "../../utils/projectDateLabel";
import {
  mergeSphereMovementOverride,
  projectZoneStops,
  PROJECT_SPHERE_IDS,
  withProjectColors,
} from "../../components/projects/detail/scene/projectSceneStops";
import { resolveStarts } from "../../components/scene/engine/zoneStops";
import { getLang, localizePath } from "../../i18n/config";
import { getLocalizedProject, getProjects } from "../../i18n/content";
import { useTranslations } from "../../i18n/ui";

interface Props {
  project: CollectionEntry<"projects">;
  prevSlug?: string;
  nextSlug?: string;
}

const { project, prevSlug, nextSlug } = Astro.props;
const lang = getLang(Astro.url);
const t = useTranslations(lang);
const { data, Content } = await getLocalizedProject(project, lang);
const { title, summary, coverImage, gallery, techStack, platforms, links, steps, demoFirst, servers, sphereColors, sphereMovement } =
  data;
const projects = getProjects(lang);

const cover = getCloudinaryUrl(coverImage, "w_900,q_auto,f_auto");
const colors = sphereColors ?? getCloudinaryColors(coverImage);
const galleryImages = gallery.map((item) => ({
  src: getCloudinaryUrl(item.image, "w_800,q_auto,f_auto"),
  alt: title,
  label: item.label,
}));
const resolvedZoneStops = resolveStarts(PROJECT_SPHERE_IDS, mergeSphereMovementOverride(projectZoneStops, sphereMovement));
const coloredZoneStops = withProjectColors(resolvedZoneStops, colors[0], colors[1]);
const currentProjectItem = projects.find((item) => item.id === project.id);
const prevHref = prevSlug ? localizePath(`/proyectos/${prevSlug}`, lang) : undefined;
const nextHref = nextSlug ? localizePath(`/proyectos/${nextSlug}`, lang) : undefined;

const mainContentEntry = await getEntry("projectContent", project.id);
const MainContent = mainContentEntry ? (await render(mainContentEntry)).Content : null;

// Selector rápido de proyectos (037/054): tarjetas con imagen+título+fecha de
// los demás proyectos, mismo formato de fecha que el listado de `/proyectos`
// y que `/admin` (`formatProjectDate`, compartido).
// La portada del selector debe ser la misma que ya usa cada proyecto en su
// propio encabezado (`coverImage` del content collection), no el `imageKey`
// de `src/data/projects.ts` — ese es un placeholder compartido entre varios
// proyectos (026) y no corresponde a la portada real de cada Markdown.
const allProjectEntries = await getCollection("projects");
const otherProjects = projects.filter((item) => item.id !== project.id).map((item) => {
  const entry = allProjectEntries.find((other) => other.id === item.id);
  return {
    href: item.link,
    title: item.title,
    date: formatProjectDate(item.date, lang),
    imageSrc: entry ? getCloudinaryUrl(entry.data.coverImage, "w_240,h_160,c_fill,q_auto,f_auto") : undefined,
  };
});
---

<BaseLayout title={`${title} - Sebastián Garzón Arias`} description={summary}>
  <ProjectPageBackground colors={colors} />
  <ProjectViewTracker slug={project.id} />
  <ProjectScene3D client:load zoneStops={coloredZoneStops} />

  <SiteMainNav client:load lang={lang} />

  <div id="project-zone-header" class="mx-auto w-full px-4 pt-12 md:w-[70%]">
    <ProjectDetailNav prevHref={prevHref} nextHref={nextHref} colors={colors} otherProjects={otherProjects} />
    <ProjectSwipeNav prevHref={prevHref} nextHref={nextHref} />

    <div class="mt-6">
      <ProjectHeader
        slug={project.id}
        title={title}
        coverSrc={cover}
        techStack={techStack}
        platforms={platforms}
        repoHref={links.repo}
        colors={colors}
        date={currentProjectItem?.date}
      />
    </div>
  </div>

  <div class="mx-auto w-full px-4 pb-28 pt-10 md:w-[70%] md:pb-16">
    <div id="project-zone-content" class="grid grid-cols-1 gap-8 md:grid-cols-[35%_auto_1fr] md:items-stretch md:gap-10">
      <ProjectDescriptionContext summary={summary}>
        <Content />
      </ProjectDescriptionContext>

      <ProjectDivider colors={colors} />

      <ProjectLiveSteps steps={steps} colors={colors} demoHref={links.demo} demoFirst={demoFirst} servers={servers} />
    </div>

    {
      galleryImages.length > 0 && (
        <div id="project-zone-gallery" class="mt-12">
          <ProjectGallery
            client:load
            images={galleryImages}
            lang={lang}
            colorLeft={`var(--project-left-color, ${colors[0]})`}
            colorRight={`var(--project-right-color, ${colors[1]})`}
          />
        </div>
      )
    }

    {
      MainContent && (
        <div class="mt-12">
          <ProjectMainContent>
            <MainContent />
          </ProjectMainContent>
        </div>
      )
    }
  </div>
</BaseLayout>
