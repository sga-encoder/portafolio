---
// Fondo estático de respaldo de `/proyectos` (listado): mismo mecanismo que
// `ProjectPageBackground.astro` de detalle, pero con los 2 colores fijos de
// `timelineColors.ts` en vez de dominantes por imagen (no hay una única
// portada protagonista en un listado). Único fondo visible si el `ProjectScene3D`
// del listado no llega a montar (sin WebGL / `prefers-reduced-motion`).
import { TIMELINE_COLORS } from "./timelineColors";

const [first, second] = TIMELINE_COLORS;
---

<div class="pointer-events-none fixed inset-0 -z-10 overflow-hidden bg-surface" aria-hidden="true">
  <div
    class="absolute left-[8%] top-[12%] h-[48vh] w-[48vh] rounded-full opacity-60 blur-3xl"
    style={`background: radial-gradient(circle, ${first} 0%, transparent 70%);`}
  >
  </div>
  <div
    class="absolute right-[8%] top-[30%] h-[45vh] w-[45vh] rounded-full opacity-60 blur-3xl"
    style={`background: radial-gradient(circle, ${second} 0%, transparent 70%);`}
  >
  </div>
</div>
