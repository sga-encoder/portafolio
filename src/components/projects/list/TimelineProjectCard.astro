---
// Tarjeta de proyecto del listado (`/proyectos`): mismo marco degradado que el
// encabezado de detalle (`ProjectHeaderFrame`, reutilizado sin modificar) con
// imagen + título, pero con la descripción breve del carrusel de Inicio
// (`ProjectItem.description`) en vez del contenido Markdown completo.
import ProjectHeaderFrame from "../detail/ProjectHeaderFrame.astro";
import ColorLinkButton from "../detail/ColorLinkButton.astro";
import { TIMELINE_COLORS } from "./timelineColors";

interface Props {
  title: string;
  description: string;
  imageSrc?: string;
  href: string;
}

const { title, description, imageSrc, href } = Astro.props;
const [, second] = TIMELINE_COLORS;
const rightColor = `var(--project-right-color, ${second})`;
---

<ProjectHeaderFrame colors={TIMELINE_COLORS}>
  <div class="aspect-video w-full shrink-0 overflow-hidden rounded-2xl bg-surface-muted md:aspect-auto md:h-full md:w-[42%]">
    {imageSrc && <img src={imageSrc} alt={title} class="h-full w-full object-cover" />}
  </div>

  <div class="flex min-w-0 flex-1 flex-col justify-center gap-3">
    <h3 class="font-display text-2xl font-bold text-ink sm:text-3xl">{title}</h3>
    <p class="font-body text-ink-muted">{description}</p>
    <ColorLinkButton href={href} color={rightColor} variant="solid" class="w-fit">
      Ver más
    </ColorLinkButton>
  </div>
</ProjectHeaderFrame>
