---
// Contador de visitas por proyecto (feature 055), Firestore. Sin UI visible
// — solo registra la visita, `/admin/proyectos` es quien muestra el dato.
// Mismo criterio de import (módulo normal, no `is:inline`, reinicializado
// por página vía `astro:page-load`) que ProjectLikeButton.astro, pero SIN
// transacción (086): `projectViews/{slug}/days/{date}` es de lectura
// admin-only (057) y un `runTransaction` exige que todas sus lecturas
// tengan éxito antes de escribir nada — esa lectura siempre daba
// permission-denied para un visitante normal y abortaba el contador
// entero. `writeBatch` + `increment()` logra el mismo "todo o nada" sin
// necesitar leer ningún documento primero.
interface Props {
  slug: string;
}

const { slug } = Astro.props;
---

<span data-view-tracker-root data-slug={slug} hidden></span>

<script>
  import { db } from "../../../lib/firebase";
  import { doc, increment, serverTimestamp, writeBatch } from "firebase/firestore";

  function todayKey(): string {
    return new Date().toISOString().slice(0, 10);
  }

  function visitedKey(slug: string): string {
    return `visited-${slug}-${todayKey()}`;
  }

  function initViewTracker(root: HTMLElement) {
    if (root.dataset.viewBound === "true") return;
    root.dataset.viewBound = "true";

    const slug = root.dataset.slug;
    if (!slug) return;

    const key = visitedKey(slug);
    if (localStorage.getItem(key) === "true") return;

    const viewRef = doc(db, "projectViews", slug);
    const dayRef = doc(db, "projectViews", slug, "days", todayKey());
    const batch = writeBatch(db);
    batch.set(viewRef, { count: increment(1), lastVisit: serverTimestamp() }, { merge: true });
    batch.set(dayRef, { count: increment(1) }, { merge: true });
    batch
      .commit()
      .then(() => {
        localStorage.setItem(key, "true");
      })
      .catch((error) => {
        // Fallo silencioso para el visitante (sin red, Firestore bloqueado,
        // etc.) — mismo criterio que ProjectLikeButton.
        console.error("No se pudo registrar la visita", error);
      });
  }

  function initAllViewTrackers() {
    document.querySelectorAll<HTMLElement>("[data-view-tracker-root]").forEach(initViewTracker);
  }

  document.addEventListener("astro:page-load", initAllViewTrackers);
</script>
