---
// Íconos del dot-nav lateral de detalle de proyecto (ProjectDetailNav) — cada
// acción se distingue por forma, no solo por color, mismo patrón inline SVG
// que PlatformIcon.astro (sin librería de íconos).
interface Props {
  icon: "chevron-left" | "home" | "grid" | "chevron-right";
}

const { icon } = Astro.props;
---

{
  icon === "chevron-left" && (
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" aria-hidden="true">
      <polyline points="15 5 7 12 15 19" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  )
}
{
  icon === "chevron-right" && (
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" aria-hidden="true">
      <polyline points="9 5 17 12 9 19" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  )
}
{
  icon === "home" && (
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" aria-hidden="true">
      <path
        d="M4 11.5 12 4l8 7.5M6 9.5V20h12V9.5"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>
  )
}
{
  icon === "grid" && (
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" aria-hidden="true">
      <rect x="3" y="3" width="7" height="7" rx="1.5" stroke="currentColor" stroke-width="2" />
      <rect x="14" y="3" width="7" height="7" rx="1.5" stroke="currentColor" stroke-width="2" />
      <rect x="3" y="14" width="7" height="7" rx="1.5" stroke="currentColor" stroke-width="2" />
      <rect x="14" y="14" width="7" height="7" rx="1.5" stroke="currentColor" stroke-width="2" />
    </svg>
  )
}
