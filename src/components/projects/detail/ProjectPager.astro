---
import ColorLinkButton from "./ColorLinkButton.astro";

interface Props {
  prevHref?: string;
  nextHref?: string;
  colors: [string, string];
}

const { prevHref, nextHref, colors } = Astro.props;
const [first, second] = colors;
const leftColor = `var(--project-left-color, ${first})`;
const rightColor = `var(--project-right-color, ${second})`;
---

<nav class="grid grid-cols-3 items-center gap-4" aria-label="Navegación entre proyectos">
  <div class="justify-self-start">
    {
      prevHref && (
        <ColorLinkButton href={prevHref} color={leftColor}>
          ← Proyecto anterior
        </ColorLinkButton>
      )
    }
  </div>

  <div class="justify-self-center">
    <ColorLinkButton href="/" color={leftColor}>
      Volver al inicio
    </ColorLinkButton>
  </div>

  <div class="justify-self-end">
    {
      nextHref && (
        <ColorLinkButton href={nextHref} color={rightColor}>
          Próximo proyecto →
        </ColorLinkButton>
      )
    }
  </div>
</nav>
