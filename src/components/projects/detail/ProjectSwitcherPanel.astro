---
// Selector rápido de proyectos (037, rediseñado en 041): botón-ícono que
// abre un panel con tarjetas (imagen+título+fecha) de los demás proyectos,
// para saltar directo a cualquiera sin depender solo de prev/siguiente.
// `<details>` nativo (sin JS de estado) + un script mínimo para cerrar al
// hacer click fuera / Escape, mismo patrón `is:inline data-astro-rerun` que
// el resto de scripts del sitio (necesario para que siga funcionando tras
// una navegación con `<ClientRouter />`, que no recarga la página).
//
// (041) "Ver todos los proyectos" ya NO es un ítem aparte del menú principal
// ni una pestaña flotante independiente (ambos diseños anteriores fallaron:
// se veía todo el tiempo en vez de solo con el menú activo, o quedaba
// desconectado del menú en mobile). Ahora es un botón *companion*, separado
// del grid de tarjetas por un `gap: 2vw` — al compartir el `display: none`
// de `.project-switcher:not([open]) .project-switcher-shell`, aparece y
// desaparece junto con el resto sin JS ni estado adicional. Una sola
// variante de nuevo (no "rail"/"mobileTop"): el trigger vive siempre dentro
// del menú principal (riel desktop / barra mobile), y el conjunto se
// posiciona distinto por breakpoint vía CSS (`@media (max-width: 767px)`) —
// en mobile usa `position: fixed` centrado, no relativo al botón de 36px
// (eso causaba que se saliera de pantalla según dónde cayera el botón en la
// barra).
// (050) "Ver todos" pasa de ser hijo de `.project-switcher-panel` (la misma
// caja con fondo/borde/blur del grid) a ser su hermano dentro de un nuevo
// `.project-switcher-shell` — dos tarjetas visualmente separadas en vez de
// una compartida. `.project-switcher-shell` es quien ahora lleva toda la
// posición/tamaño/`gap`/breakpoint mobile (antes en `.project-switcher-panel`,
// que se queda solo con el estilo visual del grid). De paso, se corrige que
// el grid pudiera necesitar scroll horizontal en escritorio: `overflow-x:
// visible` + `overflow-y: auto` es una combinación que CSS no permite — el
// navegador fuerza el eje "visible" a "auto" —, así que con `md:w-40` fijo
// en las tarjetas cualquier achique del ancho (p. ej. por el propio
// scrollbar vertical) podía disparar un scroll en X no deseado. Ahora las
// tarjetas usan `md:w-full` (llenan su columna de grid, que ya es flexible)
// y el eje X pasa a `md:overflow-x-hidden` (nunca scrollbar, solo recorte si
// sobra algún px de redondeo).
import NavIcon from "./NavIcon.astro";

interface SwitcherItem {
  href: string;
  title: string;
  date: string;
  imageSrc?: string;
}

interface Props {
  items: SwitcherItem[];
  color: string;
}

const { items, color } = Astro.props;

const circleStyle = `border: 2px solid ${color}; color: ${color}; background-color: color-mix(in srgb, var(--color-surface) 80%, transparent);`;
---

<details class="project-switcher group relative flex items-center">
  <summary
    aria-label="Cambiar de proyecto"
    class="relative z-10 flex h-9 w-9 cursor-pointer items-center justify-center rounded-full transition-transform duration-200 hover:scale-110 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-(--color-brand)"
    style={circleStyle}
  >
    <NavIcon icon="layers" />
  </summary>

  <span
    class="scroll-dot-label project-switcher-label pointer-events-none absolute whitespace-nowrap rounded-lg px-3 py-1.5 font-body text-base font-semibold"
    style={`background-color: #000622; color: ${color}; box-shadow: 0 4px 16px -2px ${color};`}
  >
    Cambiar de proyecto
  </span>

  <div class="project-switcher-shell absolute z-40 flex items-stretch">
    {
      /* (050) El botón "Ver todos" vive fuera de esta caja (hermano, no
         hijo) — este `<div>` ahora envuelve solo el grid: fondo/borde/blur
         propios de "la tarjeta de proyectos", separados de la tarjeta del
         botón. `min-height: 0` (ver `<style>`) es necesario porque ahora es
         un nivel más de flex anidado dentro de `.project-switcher-shell`: sin
         eso, se estira a la altura de su contenido en vez de encogerse al
         alto que le da el padre, y el `overflow-y-auto` del `<ul>` de abajo
         deja de activarse. */
    }
    <div
      class="project-switcher-panel flex items-stretch rounded-2xl border p-3 backdrop-blur"
      style={`border-color: ${color}; background-color: color-mix(in srgb, var(--color-surface) 92%, transparent); box-shadow: 0 12px 32px -8px ${color}; --switcher-scroll-color: ${color};`}
    >
      <ul class="project-switcher-grid flex flex-row gap-3 overflow-x-auto pb-1 md:grid md:grid-cols-2 md:overflow-x-hidden md:overflow-y-auto md:pb-0">
        {
          items.map((item) => (
            <li class="shrink-0">
              <a
                href={item.href}
                class="flex h-full w-36 flex-col gap-1 rounded-xl border border-border/60 bg-surface-muted/60 p-2 transition-colors duration-200 hover:border-(--color-brand) md:w-full"
              >
                {item.imageSrc && (
                  <img
                    src={item.imageSrc}
                    alt=""
                    loading="lazy"
                    class="h-20 w-full rounded-lg object-cover"
                  />
                )}
                <span class="font-display text-sm font-bold leading-tight text-ink">{item.title}</span>
                <span class="font-body text-xs" style={`color: ${color}`}>
                  {item.date}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    {
      /* Companion "Ver todos": en desktop, tarjeta angosta a la derecha del
         panel (mismo alto por `items-stretch` del padre), separada por el
         `gap: 2vw`. En mobile el shell pasa a columna (`flex-direction:
         column` en el `<style>`) y esta clase (`project-switcher-all`) lo
         reordena arriba del panel (`order: -1`) como una barra horizontal de
         ancho completo. Fondo/blur/sombra propios (igual criterio que
         `.project-switcher-panel`) para verse como tarjeta independiente
         ahora que ya no comparte la caja del grid. */
    }
    <a
      href="/proyectos"
      aria-label="Ver todos los proyectos"
      class="project-switcher-all flex w-20 shrink-0 flex-col items-center justify-center gap-2 rounded-xl border text-center backdrop-blur transition-colors duration-200 hover:border-(--color-brand)"
      style={`border-color: ${color}; color: ${color}; background-color: color-mix(in srgb, var(--color-surface) 92%, transparent); box-shadow: 0 12px 32px -8px ${color};`}
    >
      <NavIcon icon="grid" />
      <span class="font-body text-xs font-semibold leading-tight">Ver todos</span>
    </a>
  </div>
</details>

<style>
  .project-switcher > summary {
    list-style: none;
  }

  .project-switcher > summary::-webkit-details-marker {
    display: none;
  }

  .project-switcher:not([open]) .project-switcher-shell {
    display: none;
  }

  .project-switcher-label {
    left: 100%;
    margin-left: 0.75rem;
  }

  /* El label ("Cambiar de proyecto") comparte la regla global `.group:hover
     .scroll-dot-label, .group:focus-within .scroll-dot-label { opacity: 1;
     ... }` con el resto de labels del sitio — el `:focus-within` está ahí
     para que un usuario de teclado (tab) también lo vea. Pero en `<details>`
     el `<summary>` queda enfocado en cuanto se abre (clic o tap) y no se
     desenfoca solo por eso, así que en mobile (sin hover real) el label se
     quedaba visible todo el tiempo que el panel estuviera abierto en vez de
     solo al pasar el mouse. Se anula acá específicamente el `:focus-within`
     (con más especificidad que la regla global, sumando `.project-switcher`)
     para que este label dependa solo de `:hover`. */
  .project-switcher.group:focus-within .project-switcher-label {
    opacity: 0;
    transform: translateX(-8px) scale(0.5);
  }

  /* Panel (solo el grid, 050): ya no lleva posición/tamaño propios — los
     hereda del `.project-switcher-shell` que lo envuelve — solo necesita
     poder encogerse a la altura que le da ese padre para que el
     `overflow-y-auto` del `<ul>` interno se active (gotcha de flex anidado:
     sin `min-height: 0`, un flex item crece a la altura de su contenido en
     vez de respetar la del padre). */
  .project-switcher-panel {
    min-height: 0;
  }

  /* Desktop: el riel siempre está a la izquierda con espacio de sobra a la
     derecha, así que un ancho fijo + shell abriéndose hacia la derecha del
     botón nunca se sale de pantalla. */
  .project-switcher-shell {
    left: 100%;
    top: 50%;
    /* La mitad del espacio que antes separaba el panel del botón "Ver todos"
       (`gap` de 2vw a 1vw, ver abajo) se movió acá — pedido explícito del
       usuario: menos aire entre panel/botón, más aire entre el menú y todo
       el conjunto. */
    margin-left: calc(0.75rem + 1vw);
    transform: translateY(-50%);
    gap: 1vw;
    /* Ancho: el contenedor de posicionamiento (`<details>`) mide solo 36px
       (el botón), así que el "shrink-to-fit" por defecto de un absolute con
       `left` fijo pero sin `width` calcula el espacio disponible sobre esos
       36px y colapsa el shell al mínimo — hay que fijar el ancho a mano.
       27.5rem = grid (2 tarjetas de 10rem + gap-3) + botón companion (w-20) +
       padding; se suma el `1vw` del gap aparte para que no se lo coma el
       ancho fijo en viewports grandes (el `gap` crece con el viewport, el
       ancho debe crecer con él o el contenido desborda). */
    width: calc(27.5rem + 1vw);
    max-height: 20rem;
  }

  /* Scrollbar del grid en escritorio (donde scrollea en Y, `md:overflow-y-auto`):
     delgada y del color del propio proyecto (`--switcher-scroll-color`, seteada
     inline en `.project-switcher-panel` y heredada) en vez del scrollbar
     genérico del navegador — Firefox vía `scrollbar-width`/`scrollbar-color`,
     Chrome/Safari vía `::-webkit-scrollbar*`. En mobile el grid scrollea en X
     dentro de una barra fija inferior (carrusel de tarjetas, con inercia
     táctil) y se deja el scrollbar nativo del sistema, sin estilizar. */
  @media (min-width: 768px) {
    .project-switcher-grid {
      scrollbar-width: thin;
      scrollbar-color: var(--switcher-scroll-color, var(--color-brand)) transparent;
    }

    .project-switcher-grid::-webkit-scrollbar {
      width: 6px;
    }

    .project-switcher-grid::-webkit-scrollbar-track {
      background: transparent;
    }

    .project-switcher-grid::-webkit-scrollbar-thumb {
      background-color: var(--switcher-scroll-color, var(--color-brand));
      border-radius: 9999px;
    }

    .project-switcher-grid::-webkit-scrollbar-thumb:hover {
      background-color: color-mix(in srgb, var(--switcher-scroll-color, var(--color-brand)) 80%, white);
    }
  }

  @media (max-width: 767px) {
    .project-switcher-label {
      left: auto;
      right: 0;
      margin-left: 0;
      bottom: 100%;
      margin-bottom: 0.5rem;
    }

    /* El trigger vive dentro de la barra inferior y puede caer en cualquier
       punto de la fila — posicionar el shell relativo a esos 36px del botón
       lo dejaba parcial o totalmente fuera de pantalla según dónde cayera.
       `position: fixed` + centrado horizontal, anclado arriba de la barra,
       es robusto sin importar la posición del botón (fix validado en 037). */
    .project-switcher-shell {
      position: fixed;
      left: 50%;
      right: auto;
      top: auto;
      bottom: calc(6rem + env(safe-area-inset-bottom));
      margin: 0;
      transform: translateX(-50%);
      /* Columna en vez de fila: "Ver todos" (reordenado arriba con
         `order: -1` en `.project-switcher-all`) queda arriba del panel en
         vez de al lado — pedido explícito del usuario ("el botón ver todos
         en el celular ubícalo en la parte superior"). */
      flex-direction: column;
      width: min(20rem, calc(100vw - 2rem));
      max-height: 60vh;
      /* El ajuste de escritorio (mitad del `gap` movida al `margin-left` del
         menú, ver arriba) no aplica acá: mobile no tiene esa separación con
         el menú (el shell es `position: fixed` centrado, no pegado al
         trigger), así que mantiene el `gap` original sin cambios. */
      gap: 2vw;
    }

    .project-switcher-all {
      order: -1;
      width: 100%;
      flex-direction: row;
      /* Más aire arriba/abajo: en fila (icono + texto lado a lado, sin el
         `items-stretch` alto del riel de escritorio) se sentía apretado
         pegado al borde superior/inferior del botón. */
      padding-block: 1rem;
    }
  }
</style>

<script is:inline data-astro-rerun>
  (function () {
    // Blur del <summary> al cerrarse: sin esto, el foco se queda ahí pegado
    // (ni un click afuera, ni Escape, ni volver a clickear el mismo ícono lo
    // quitan solos), así que el `focusin` que pausó la animación idle de
    // `049` (BaseLayout.astro, sobre `.nav-rail-glow`) nunca recibe su
    // `focusout` — el contador de interacciones queda atascado y la
    // animación no vuelve a moverse nunca (reportado por el usuario: "se
    // desactiva la animación [y] no continúa"). `toggle` cubre las 3 formas
    // de cerrar (click afuera / Escape / re-click del mismo ícono) porque
    // dispara siempre que cambia `.open`, sin importar la causa. Guard por
    // `dataset` por elemento (no por `document.body` como el resto de este
    // script) porque cada `.project-switcher` es una instancia nueva por
    // página (riel desktop + barra mobile, 2 por página) y necesita su
    // propio listener.
    document.querySelectorAll("details.project-switcher").forEach((details) => {
      if (details.dataset.toggleBlurBound === "true") return;
      details.dataset.toggleBlurBound = "true";

      details.addEventListener("toggle", () => {
        if (details.open) return;
        const summary = details.querySelector("summary");
        if (summary && document.activeElement === summary) summary.blur();
      });
    });

    if (document.body.dataset.projectSwitcherBound === "true") return;
    document.body.dataset.projectSwitcherBound = "true";

    function closeOpenPanels(except) {
      document.querySelectorAll("details.project-switcher[open]").forEach((el) => {
        if (el !== except) el.open = false;
      });
    }

    document.addEventListener("click", (event) => {
      const openPanel = event.target.closest && event.target.closest("details.project-switcher[open]");
      closeOpenPanels(openPanel || null);
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") closeOpenPanels(null);
    });
  })();
</script>
