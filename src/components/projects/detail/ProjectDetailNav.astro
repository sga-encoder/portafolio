---
// Reemplaza a ProjectPager (3 botones de texto en fila) por un menú de
// navegación tipo dot-nav (mismo mecanismo visual que ScrollDotNav/YearDotNav:
// fijo al lateral, label en hover, oculto en mobile). A diferencia de esos
// dos -que son scroll-spy entre secciones equivalentes-, aquí las 4 acciones
// son distintas (retroceder/avanzar/inicio/cambiar de proyecto), así que
// cada ítem se distingue por forma/ícono además de color, y el "activo" no
// existe: en su lugar hay un estado deshabilitado para anterior/siguiente en
// los extremos.
// (037) El riel/barra ganan un borde animado (`NAV_RAIL_FRAME`/`.nav-rail-glow`)
// y, en mobile, mantener presionado un botón muestra su label sin navegar
// hasta soltar (mismo mecanismo que ScrollDotNav/YearDotNav, pero aquí los
// ítems son `<a href>` en vez de `<button onClick>`, así que el gating vive
// en un script inline en vez de React).
// (041) "Ver todos los proyectos" ya NO es un ítem de este menú — pasó a ser
// un botón companion *dentro* del panel del selector rápido
// (`ProjectSwitcherPanel`), visible solo mientras ese panel está abierto (ver
// ese componente). El menú principal queda simétrico en desktop y mobile: 4
// ítems — anterior, inicio, selector rápido (ícono capas), siguiente —, sin
// pestañas ni botones flotantes aparte.
// (054) `ProjectSwitcherPanel` vive en `src/components/nav/` como componente
// React compartido con `/admin` (`AdminDotNav.tsx`), en vez del `.astro`
// propio de este directorio que tenía antes — montado acá como `client:load`.
import NavIcon from "./NavIcon.astro";
import ProjectSwitcherPanel from "../../nav/ProjectSwitcherPanel";
import {
  NAV_BAR_MOBILE,
  NAV_BAR_MOBILE_LIST,
  NAV_ITEM_HIT_AREA,
  NAV_RAIL_DESKTOP,
  NAV_RAIL_FRAME,
  NAV_RAIL_LIST,
} from "../../nav/navRailClasses";

interface SwitcherItem {
  href: string;
  title: string;
  date: string;
  imageSrc?: string;
}

interface Props {
  prevHref?: string;
  nextHref?: string;
  colors: [string, string];
  otherProjects: SwitcherItem[];
}

const { prevHref, nextHref, colors, otherProjects } = Astro.props;
const [first, second] = colors;
const leftColor = `var(--project-left-color, ${first})`;
const rightColor = `var(--project-right-color, ${second})`;
const hasSwitcher = otherProjects.length > 0;

interface NavItem {
  key: string;
  label: string;
  href?: string;
  color: string;
  disabled: boolean;
  icon: "chevron-left" | "home" | "chevron-right";
}

const prevItem: NavItem = {
  key: "prev",
  label: "Proyecto anterior",
  href: prevHref,
  color: leftColor,
  disabled: !prevHref,
  icon: "chevron-left",
};
const homeItem: NavItem = {
  key: "home",
  label: "Volver al inicio",
  href: "/",
  color: leftColor,
  disabled: false,
  icon: "home",
};
const nextItem: NavItem = {
  key: "next",
  label: "Próximo proyecto",
  href: nextHref,
  color: rightColor,
  disabled: !nextHref,
  icon: "chevron-right",
};

type RailEntry = { kind: "item"; item: NavItem } | { kind: "switcher" };

// Mismo orden en desktop y mobile: ya no hay asimetría entre riel y barra.
const entries: RailEntry[] = [
  { kind: "item", item: prevItem },
  { kind: "item", item: homeItem },
  ...(hasSwitcher ? [{ kind: "switcher" } as const] : []),
  { kind: "item", item: nextItem },
];

const circleStyle = (color: string) =>
  `border: 2px solid ${color}; color: ${color}; background-color: color-mix(in srgb, var(--color-surface) 80%, transparent);`;
---

{
  /* Desktop: nav lateral fijo, mismo criterio hidden/md:flex que ScrollDotNav/YearDotNav. */
}
<nav aria-label="Navegación entre proyectos" class={NAV_RAIL_DESKTOP}>
  <div class={NAV_RAIL_FRAME}>
    <ul class={NAV_RAIL_LIST}>
      {
        entries.map((entry) =>
          entry.kind === "switcher" ? (
            <li class="relative flex items-center">
              <ProjectSwitcherPanel client:load items={otherProjects} color={rightColor} allHref="/proyectos" />
            </li>
          ) : (
            <li class="group relative flex items-center">
              {entry.item.disabled ? (
                <span
                  aria-hidden="true"
                  class="relative z-10 flex h-9 w-9 items-center justify-center rounded-full opacity-30"
                  style={circleStyle(entry.item.color)}
                >
                  <NavIcon icon={entry.item.icon} />
                </span>
              ) : (
                <>
                  <a
                    href={entry.item.href}
                    aria-label={entry.item.label}
                    class="relative z-10 flex h-9 w-9 items-center justify-center rounded-full transition-transform duration-200 hover:scale-110 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-(--color-brand)"
                    style={circleStyle(entry.item.color)}
                  >
                    <NavIcon icon={entry.item.icon} />
                  </a>
                  <span
                    class="scroll-dot-label pointer-events-none absolute left-full ml-3 whitespace-nowrap rounded-lg px-3 py-1.5 font-body text-base font-semibold"
                    style={`background-color: #000622; color: ${entry.item.color}; box-shadow: 0 4px 16px -2px ${entry.item.color};`}
                  >
                    {entry.item.label}
                  </span>
                </>
              )}
            </li>
          ),
        )
      }
    </ul>
  </div>
</nav>

{
  /* Mobile: barra fija inferior. Mantener presionado muestra el label
     (`.scroll-dot-label`/`is-pressed`, ver `holdToNavigate.ts`); la
     navegación solo se dispara al soltar encima del botón (037). El
     selector rápido vive acá también (no aparte, 041) — su panel se
     posiciona `fixed`/centrado vía CSS global (`.project-switcher-shell`,
     `global.css`), no un `<style>` scoped (054, ver `ProjectSwitcherPanel.tsx`). */
}
<nav aria-label="Navegación entre proyectos" class={NAV_BAR_MOBILE}>
  <ul class={`${NAV_BAR_MOBILE_LIST} hold-to-navigate-list`}>
    {
      entries.map((entry) =>
        entry.kind === "switcher" ? (
          <li class="relative flex items-center">
            <ProjectSwitcherPanel client:load items={otherProjects} color={rightColor} allHref="/proyectos" />
          </li>
        ) : (
          <li class="group relative flex items-center">
            {entry.item.disabled ? (
              <span aria-hidden="true" class={`${NAV_ITEM_HIT_AREA} opacity-30`}>
                <span
                  class="flex h-9 w-9 items-center justify-center rounded-full"
                  style={circleStyle(entry.item.color)}
                >
                  <NavIcon icon={entry.item.icon} />
                </span>
              </span>
            ) : (
              <>
                <a
                  href={entry.item.href}
                  aria-label={entry.item.label}
                  data-hold-nav={entry.item.href}
                  class={NAV_ITEM_HIT_AREA}
                >
                  <span
                    class="flex h-9 w-9 items-center justify-center rounded-full transition-transform duration-200 active:scale-95"
                    style={circleStyle(entry.item.color)}
                  >
                    <NavIcon icon={entry.item.icon} />
                  </span>
                </a>
                <span
                  class="scroll-dot-label pointer-events-none absolute bottom-full left-0 mb-2 whitespace-nowrap rounded-lg px-3 py-1.5 font-body text-base font-semibold"
                  style={`background-color: #000622; color: ${entry.item.color}; box-shadow: 0 4px 16px -2px ${entry.item.color};`}
                >
                  {entry.item.label}
                </span>
              </>
            )}
          </li>
        ),
      )
    }
  </ul>
</nav>

<script is:inline data-astro-rerun>
  (function () {
    document.querySelectorAll(".hold-to-navigate-list").forEach((list) => {
      if (list.dataset.holdBound === "true") return;
      list.dataset.holdBound = "true";

      var pressedLink = null;

      function setPressed(link, pressed) {
        var group = link && link.closest(".group");
        if (group) group.classList.toggle("is-pressed", pressed);
      }

      function clear() {
        setPressed(pressedLink, false);
        pressedLink = null;
      }

      list.addEventListener("pointerdown", function (event) {
        if (event.pointerType !== "touch") return;
        var link = event.target.closest && event.target.closest("[data-hold-nav]");
        if (!link) return;
        pressedLink = link;
        setPressed(link, true);
        event.preventDefault();
      });

      list.addEventListener("pointerup", function (event) {
        if (event.pointerType !== "touch" || !pressedLink) return;
        var link = pressedLink;
        var rect = link.getBoundingClientRect();
        var inside =
          event.clientX >= rect.left &&
          event.clientX <= rect.right &&
          event.clientY >= rect.top &&
          event.clientY <= rect.bottom;
        clear();
        if (inside) window.location.href = link.getAttribute("data-hold-nav");
      });

      list.addEventListener("pointercancel", clear);
    });
  })();
</script>
