---
import { getLang } from "../../../i18n/config";
import { useTranslations } from "../../../i18n/ui";
interface Props {
  summary: string;
}

const { summary } = Astro.props;
const t = useTranslations(getLang(Astro.url));
---

<div class="flex h-full flex-col gap-4">
  <div class="rounded-2xl bg-surface-muted p-4">
    <h2 class="font-display text-sm font-bold uppercase tracking-wide text-ink-muted">{t("project.description")}</h2>
    <p class="mt-2 font-body text-lg text-ink">{summary}</p>
  </div>

  <div class="min-w-0 rounded-2xl bg-surface-muted p-4">
    <h2 class="font-display text-sm font-bold uppercase tracking-wide text-ink-muted">{t("project.context")}</h2>
    <div class="prose dark:prose-invert mt-2 max-w-none font-body prose-p:text-ink prose-li:text-ink">
      <slot />
    </div>
  </div>
</div>
