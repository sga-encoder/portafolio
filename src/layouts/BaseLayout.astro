---
import "../styles/global.css";
import "@fontsource/space-grotesk/700.css";
import "@fontsource/montserrat/400.css";
import { ClientRouter } from "astro:transitions";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description?: string;
  showHeader?: boolean;
  noindex?: boolean;
}

const {
  title,
  description = "Portafolio personal: hoja de vida y blog.",
  showHeader = true,
  noindex = false,
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <script is:inline data-astro-rerun>
      // Modo claro desactivado temporalmente (feature 011) — siempre oscuro.
      // `data-astro-rerun`: sin esto, el script no se re-ejecuta en navegaciones
      // por View Transitions (ClientRouter) y la clase se pierde al navegar.
      document.documentElement.classList.add("dark");
    </script>
    <ClientRouter />
  </head>
  <body class="flex min-h-screen flex-col bg-surface text-ink antialiased">
    {showHeader && <Header />}
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
