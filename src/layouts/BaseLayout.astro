---
import "../styles/global.css";
import "@fontsource/space-grotesk/700.css";
import "@fontsource/montserrat/400.css";
import { ClientRouter } from "astro:transitions";
import Footer from "../components/Footer.astro";
import { getLang, LANG_STORAGE_KEY, switchLangPath } from "../i18n/config";
import { useTranslations } from "../i18n/ui";

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}

const lang = getLang(Astro.url);
const t = useTranslations(lang);

const {
  title,
  description = t("site.description"),
  noindex = false,
} = Astro.props;

// Detección automática de idioma (100): solo en páginas del sitio público que existen en ambos
// idiomas — `/admin` usa este mismo layout y no tiene versión en inglés.
const pathname = Astro.url.pathname;
const isBilingual = !/^\/(en\/)?(admin|api)(\/|$)/.test(pathname);
const alternates = Astro.site && isBilingual
  ? (["es", "en"] as const).map((code) => ({ code, href: new URL(switchLangPath(pathname, code), Astro.site).href }))
  : [];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {alternates.map((alt) => <link rel="alternate" hreflang={alt.code} href={alt.href} />)}
    {
      isBilingual && (
        <script
          is:inline
          data-lang={lang}
          data-other={switchLangPath(pathname, lang === "es" ? "en" : "es")}
          data-key={LANG_STORAGE_KEY}
        >
          // Idioma automático (100): la elección manual del toggle (localStorage) manda; sin ella, el
          // idioma del navegador (español → es, cualquier otro → en). Corre antes de pintar y sin
          // `data-astro-rerun` — solo en cargas completas: las navegaciones internas ya van al idioma
          // correcto porque todos los enlaces están localizados. Los bots no se redirigen, para que
          // cada idioma se indexe en su propia URL.
          (function () {
            var el = document.currentScript;
            if (!el) return;
            if (/bot|crawl|spider|slurp|lighthouse|headless/i.test(navigator.userAgent)) return;
            var pref = null;
            try {
              pref = localStorage.getItem(el.dataset.key);
            } catch (e) {}
            var browser = (navigator.languages && navigator.languages[0]) || navigator.language || "es";
            var wanted = pref === "es" || pref === "en" ? pref : /^es\b/i.test(browser) ? "es" : "en";
            if (wanted !== el.dataset.lang) location.replace(el.dataset.other + location.search + location.hash);
          })();
        </script>
      )
    }
    <script is:inline data-astro-rerun>
      // Modo claro desactivado temporalmente (feature 011) — siempre oscuro.
      // `data-astro-rerun`: sin esto, el script no se re-ejecuta en navegaciones
      // por View Transitions (ClientRouter) y la clase se pierde al navegar.
      document.documentElement.classList.add("dark");
    </script>
    <script is:inline>
      // Pausa/reanuda la animación idle (049) de los 3 dot-nav (ScrollDotNav/
      // YearDotNav/ProjectDetailNav) mientras alguien interactúa con ellos —
      // comparten `.nav-rail-glow` como único punto de enganche, así que un
      // solo script global cubre los 3 sin tocar cada componente. Este script
      // vive en <head>, antes de que exista el <body>, y ninguno de los 3
      // navs usa `transition:persist` (se remontan en cada navegación), así
      // que se engancha a `astro:page-load` (dispara en la carga inicial y en
      // cada transición) en vez de correr una sola vez al parsear — mismo
      // patrón que `ProjectLikeButton.astro`. El guard (un WeakSet en memoria)
      // evita doble-bind si el nodo persiste entre dos disparos del evento; no
      // se marca el nodo con un atributo porque estos navs son islas React y
      // un atributo agregado antes de hidratar da "hydration mismatch".
      const navRailBound = new WeakSet();
      function initNavRailIdlePause() {
        const rails = Array.from(document.querySelectorAll(".nav-rail-glow"));
        if (!rails.length) return;

        const phase = `${-((performance.now() / 1000) % 6).toFixed(2)}s`;
        document.documentElement.style.setProperty("--nav-rail-phase", phase);

        let globalActiveInteractions = 0;

        const pauseAll = () => {
          globalActiveInteractions++;
          rails.forEach((rail) => rail.classList.add("is-paused"));
        };

        const resumeAll = () => {
          globalActiveInteractions = Math.max(0, globalActiveInteractions - 1);
          if (globalActiveInteractions === 0) {
            rails.forEach((rail) => rail.classList.remove("is-paused"));
          }
        };

        rails.forEach((el) => {
          if (navRailBound.has(el)) return;
          navRailBound.add(el);

          el.addEventListener("pointerenter", pauseAll);
          el.addEventListener("pointerleave", resumeAll);
          el.addEventListener("focusin", pauseAll);
          el.addEventListener("focusout", resumeAll);
          el.addEventListener("touchstart", pauseAll, { passive: true });
          el.addEventListener("touchend", resumeAll);
          el.addEventListener("touchcancel", resumeAll);
        });
      }
      document.addEventListener("astro:page-load", initNavRailIdlePause);
    </script>
    <ClientRouter />
  </head>
  <body class="flex min-h-screen flex-col bg-surface text-ink antialiased">
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
