---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ContentList from "../../../components/admin/ContentList";
import { buildProjectCardGroups } from "../../../lib/admin/projectCards";

const groups = await buildProjectCardGroups();
const switcherProjects = groups.flatMap((group) => group.projects);
---

<BaseLayout title="Admin · Proyectos" noindex>
  <ContentList client:load groups={groups} switcherProjects={switcherProjects} />
</BaseLayout>
