---
import { getCollection } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ContentEditor from "../../../components/admin/ContentEditor";
import { buildProjectCards } from "../../../lib/admin/projectCards";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({ params: { slug: project.id }, props: { slug: project.id } }));
}

const { slug } = Astro.props;
const switcherProjects = await buildProjectCards();
---

<BaseLayout title={`Admin · ${slug}`} noindex>
  <ContentEditor client:load slug={slug} switcherProjects={switcherProjects} />
</BaseLayout>
