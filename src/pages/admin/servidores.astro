---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ServersPanel from "../../components/admin/ServersPanel";
import { buildProjectCards } from "../../lib/admin/projectCards";

const entries = await getCollection("projects");
const projects = entries.map((project) => ({ slug: project.id, title: project.data.title }));
const switcherProjects = await buildProjectCards();
---

<BaseLayout title="Admin · Servidores" noindex>
  <ServersPanel client:load projects={projects} switcherProjects={switcherProjects} />
</BaseLayout>
