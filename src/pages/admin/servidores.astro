---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ServersPanel from "../../components/admin/ServersPanel";

const entries = await getCollection("projects");
const projects = entries.map((project) => ({ slug: project.id, title: project.data.title }));
---

<BaseLayout title="Admin · Servidores" showHeader={false} noindex>
  <ServersPanel client:load projects={projects} />
</BaseLayout>
