---
import BaseLayout from "../../layouts/BaseLayout.astro";
import DashboardPanel from "../../components/admin/DashboardPanel";
import { buildProjectCards } from "../../lib/admin/projectCards";

const switcherProjects = await buildProjectCards();
const slugs = switcherProjects.map((project) => project.slug);
---

<BaseLayout title="Admin · Panel" noindex>
  <DashboardPanel client:load slugs={slugs} switcherProjects={switcherProjects} />
</BaseLayout>
