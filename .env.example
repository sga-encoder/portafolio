# Cloudinary — solo necesario si vas a agregar/cambiar imágenes en cloudinary-images/.
# Sin estas credenciales, "npm run dev" y "npm run build" funcionan igual (las imágenes
# ya subidas se sirven desde el manifest commiteado en src/data/cloudinaryManifest.json).
# Conseguir estos valores en https://console.cloudinary.com/ (Dashboard).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Firebase — likes por proyecto (feature 040), /proyectos/[slug].
# Config pública de la Web app en https://console.firebase.google.com/ (Configuración del proyecto).
# Sin estos valores, el botón de like queda montado pero falla en silencio (comportamiento esperado).
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_APP_ID=
# App Check (reCAPTCHA v3) — opcional pero recomendado, ver plan.md de 040. Site key pública
# en Firebase console → App Check → registrar app → proveedor reCAPTCHA v3.
PUBLIC_FIREBASE_RECAPTCHA_SITE_KEY=
